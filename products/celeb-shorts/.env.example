# 17. 연예인 착용템 쇼츠 기획기 · 셀럽오르빗 — 환경변수 예시
#
# 설치.bat 이 이 파일을 저장소 맨 위 폴더의 .env 로 복사합니다(이미 있으면 건드리지 않음).
# **.env 는 절대 커밋하지 않습니다.** 메모장으로 열어 = 뒤에 값을 넣고 저장하세요.

# 대본을 쓰는 데 씁니다. 없으면 모의 생성만 됩니다. https://console.anthropic.com
ANTHROPIC_API_KEY=

# 모델 — 바꿀 때만 고치세요. 빈칸으로 두면 안 됩니다.
CLAUDE_MODEL=claude-sonnet-4-6

# (선택) AI 음성 — Google Cloud Text-to-Speech API 키. 없으면 자막만으로 만듭니다.
GOOGLE_TTS_API_KEY=

# (선택) FFmpeg 가 PATH 에 없을 때만 — 예: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
