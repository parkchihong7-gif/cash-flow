# 13. 니치 리서치 — 환경변수
#
# .env 로 복사해서 채우세요. **.env 는 절대 커밋하지 않습니다.**

# 유튜브 데이터 API v3 키.
# console.cloud.google.com → API 및 서비스 → YouTube Data API v3 사용 설정 → 키 만들기
# **무료입니다.** 하루 10,000 유닛을 줍니다.
YOUTUBE_API_KEY=

# 지표 해설 5줄을 쓰는 데 씁니다. 없으면 수집·분석은 그대로 되고 해설만 빠집니다.
ANTHROPIC_API_KEY=

# 하루에 볼 키워드 수 상한. 유튜브 쿼터를 넘지 않게 코드가 강제합니다.
# search.list 한 번에 100 유닛이라 80개면 8,000 유닛입니다.
DAILY_KEYWORD_LIMIT=80

# 자료를 둘 곳.
NICHE_DB_PATH=./niche.db
NICHE_STATE_PATH=./state.json
