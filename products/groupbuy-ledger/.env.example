# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.

# 정산 리포트의 세 줄 코멘트를 받을 때만 씁니다.
# 장부를 만들고(new) 주문을 넣는(import-orders) 데는 필요하지 않습니다.
ANTHROPIC_API_KEY=sk-ant-여기에_키를_넣으세요

# 쓰지 않으려면 지워도 됩니다. 기본값은 claude-sonnet-4-6 입니다.
CLAUDE_MODEL=claude-sonnet-4-6

# AI 생성물 표시를 기본으로 켤지. 인공지능기본법 제31조 대응입니다.
AI_LABEL=true
