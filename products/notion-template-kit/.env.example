# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.

# 설계와 문구를 만들 때 씁니다. plan 에 필요합니다.
ANTHROPIC_API_KEY=sk-ant-여기에_키를_넣으세요
CLAUDE_MODEL=claude-sonnet-4-6

# AI 생성물 표시 (인공지능기본법 제31조). 켜두는 것을 권합니다.
AI_LABEL=true

# ---------------------------------------------------------------- 노션 (선택)
# 아래 둘은 `deploy` 로 노션에 실제로 만들 때만 필요합니다.
# 없어도 됩니다. build_guide.md 를 보며 손으로 만드셔도 결과는 같습니다.
#
# 1) notion.so/my-integrations 에서 통합을 만들고 토큰을 받습니다.
NOTION_TOKEN=
#
# 2) 만들 자리가 될 노션 페이지를 하나 만들고,
#    그 페이지 오른쪽 위 ··· → 연결 → 방금 만든 통합을 고릅니다.
#    이걸 빠뜨리면 토큰이 있어도 "권한이 없다" 고 나옵니다. 가장 흔한 실수입니다.
#    페이지 주소를 통째로 붙여넣으셔도 됩니다. id 만 알아서 뽑습니다.
NOTION_PARENT_PAGE_ID=
