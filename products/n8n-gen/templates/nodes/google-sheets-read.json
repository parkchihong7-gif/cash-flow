{
  "id": "google-sheets-read",
  "label": "구글시트 읽기",
  "category": "data",
  "description": "시트의 행을 읽어옵니다.",
  "n8n_type": "n8n-nodes-base.googleSheets",
  "type_version": 4.5,
  "is_trigger": false,
  "credential": "googleSheetsOAuth2Api",
  "params": [
    {
      "key": "document_id",
      "label": "스프레드시트 ID",
      "type": "string",
      "default": "[스프레드시트 ID를 넣으세요]"
    },
    {
      "key": "sheet_name",
      "label": "시트(탭) 이름",
      "type": "string",
      "default": "시트1"
    }
  ],
  "parameters": {
    "operation": "read",
    "documentId": {
      "__rl": true,
      "value": "{{document_id}}",
      "mode": "id"
    },
    "sheetName": {
      "__rl": true,
      "value": "{{sheet_name}}",
      "mode": "name"
    },
    "options": {}
  },
  "outputs": [
    "main"
  ],
  "inputs": 1
}
