{
  "id": "notion-create-page",
  "label": "노션 페이지 생성",
  "category": "data",
  "description": "노션 데이터베이스에 페이지를 만듭니다.",
  "n8n_type": "n8n-nodes-base.notion",
  "type_version": 2.2,
  "is_trigger": false,
  "credential": "notionApi",
  "params": [
    {
      "key": "database_id",
      "label": "데이터베이스 ID",
      "type": "string",
      "default": "[데이터베이스 ID]"
    },
    {
      "key": "title",
      "label": "페이지 제목",
      "type": "string",
      "default": "={{ $json.title }}"
    }
  ],
  "parameters": {
    "resource": "databasePage",
    "operation": "create",
    "databaseId": {
      "__rl": true,
      "value": "{{database_id}}",
      "mode": "id"
    },
    "title": "{{title}}",
    "options": {}
  },
  "outputs": [
    "main"
  ],
  "inputs": 1
}
