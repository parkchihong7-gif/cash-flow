# 15. 네이버 블로그 포스팅 초안 생성기
# 이 파일을 .env 로 복사해 쓰세요. .env 는 절대 공유하지 마세요.

# --- 네이버 공개 API (수요 조회용) ---
# developers.naver.com 에서 앱 등록 → 사용 API 에 '검색'과 '데이터랩' 추가
# 무료이고 심사 없이 바로 나옵니다. 하루 25,000회.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 초안 문장 (선택) ---
# 없으면 뼈대만 만듭니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# 산출물에 AI 생성물 표시를 붙일지. 기본은 켜짐.
AI_LABEL=1

# ※ 네이버 아이디·비밀번호를 여기 적지 마세요.
#    이 프로그램은 네이버에 로그인하지 않습니다. 그럴 일이 없습니다.
