# 10. 제휴 상품 매칭 로직 — 환경변수 예시
#
# 이 파일을 .env 로 복사해 쓰세요. **.env 는 절대 커밋하지 않습니다.**
# 저장소 맨 위 폴더의 .env 하나만 있어도 됩니다.

# 원고를 읽는 데 씁니다. 없으면 --dry-run 만 됩니다.
ANTHROPIC_API_KEY=

# 쿠팡파트너스 오픈 API 키 — **없어도 됩니다.**
# 없으면 검색 주소만 만들고 정상 종료합니다. 오류가 아닙니다.
# 파트너스 사이트에서 발급하며, 실적 요건이 있어 가입 직후에는 안 열릴 수 있습니다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 딥링크에 붙일 채널 구분값(선택). 어느 채널에서 팔렸는지 나눠 보고 싶을 때만.
COUPANG_SUB_ID=
