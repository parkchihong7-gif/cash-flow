# 카카오 FAQ 챗봇 — 환경변수
#
# 이 파일을 .env 로 복사해서 채우세요. **.env 는 절대 커밋하지 않습니다.**

# ─── Claude ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
# 답이 느리면 카카오가 끊습니다. 4초를 넘기지 마세요.
CLAUDE_TIMEOUT_SECONDS=4.0

# ─── FAQ 원본 ─────────────────────────────────────────────
# 구글시트 주소 가운데의 긴 문자열입니다.
#   https://docs.google.com/spreadsheets/d/<여기>/edit
SHEET_ID=
FAQ_SHEET_NAME=FAQ

# 서비스 계정 키 파일 경로.
# ⚠️ 시트를 서비스 계정 이메일에 **뷰어로 공유**해야 읽힙니다. 가장 흔한 실수입니다.
GOOGLE_CREDENTIALS_JSON=./credentials.json

# 시트가 아직 없을 때 쓰는 CSV. SHEET_ID 가 비어 있을 때만 씁니다.
FAQ_CSV=./sample_faq.csv

# 시트를 다시 읽는 주기(초). 300 = 5분.
FAQ_CACHE_SECONDS=300

# ─── 기록 ─────────────────────────────────────────────────
LOG_DB_PATH=./logs.db
# 이용자 아이디를 해시할 때 섞는 값. 아무 긴 문자열이나 넣으세요.
# 바뀌면 예전 기록과 이어지지 않습니다.
LOG_SALT=

# ─── 표시 ─────────────────────────────────────────────────
# AI 응답 표시. 인공지능기본법 제31조에 따라 켜 두세요.
AI_LABEL=true
AI_LABEL_TEXT=🤖 AI 자동 응답입니다.

# ─── 서버 ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
