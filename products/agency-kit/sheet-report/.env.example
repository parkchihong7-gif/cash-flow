# 주간 보고서 (모듈 B) — 환경변수
#
# .env 로 복사해서 채우세요. **.env 는 절대 커밋하지 않습니다.**
# 시트가 없으면 --csv 로 돌려 보실 수 있습니다.

# ─── Claude (해석 3줄 + 할 일 2개) ────────────────────────
ANTHROPIC_API_KEY=

# ─── 구글시트 ─────────────────────────────────────────────
# 서비스 계정 키 파일 경로.
# ⚠️ 시트를 서비스 계정 이메일에 **뷰어로 공유**해야 읽힙니다.
GOOGLE_CREDENTIALS_JSON=./credentials.json

# ─── 보내기 (둘 다 선택) ──────────────────────────────────
# 슬랙 '들어오는 웹훅' 주소. 봇 토큰이 아닙니다.
SLACK_WEBHOOK_URL=

# 메일. Gmail 이면 **앱 비밀번호**를 쓰세요. 계정 비밀번호는 안 됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAIL_TO=
