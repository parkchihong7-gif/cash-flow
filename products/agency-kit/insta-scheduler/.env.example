# 인스타 예약 발행 (모듈 C) — 환경변수
#
# .env 로 복사해서 채우세요. **.env 는 절대 커밋하지 않습니다.**
# 토큰이 없어도 큐·승인 흐름은 그대로 돌아갑니다(모의 실행).

# ─── Claude (캡션 초안) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ─── 인스타그램 ───────────────────────────────────────────
# 비즈니스/크리에이터 계정이어야 합니다. 개인 계정은 API 로 못 올립니다.
# 페이스북 페이지와 연결도 되어 있어야 합니다.
IG_USER_ID=
# 60일짜리 장기 토큰. manage.py refresh-token 으로 갱신합니다.
IG_ACCESS_TOKEN=

# 토큰 갱신에 필요합니다. Meta 개발자 → 앱 → 설정 → 기본.
FB_APP_ID=
FB_APP_SECRET=

# 그래프 API 판. 올라가면 여기만 바꾸면 됩니다.
GRAPH_API_VERSION=v21.0

# 24시간 게시 한도. 인스타가 25건까지 받습니다.
IG_DAILY_LIMIT=25

# ─── 큐 ───────────────────────────────────────────────────
QUEUE_DB_PATH=./queue.db
# 큐를 보는 간격(초).
TICK_SECONDS=60
TZ=Asia/Seoul
