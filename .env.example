# 복사해서 .env 로 쓴다. .env 는 절대 커밋하지 않는다. (CLAUDE.md §6)

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# 기본 모델 / 토큰 (생략 시 shared/config.py 기본값 사용)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4000

# AI 생성물 표시 기본값 (인공지능기본법 제31조). 끄려면 0/false
AI_LABEL=1

# ---------------------------------------------------------------- 대시보드 접속
# 대시보드는 이 코드를 넣어야 열린다.
# 인터넷에 열어 두실 거라면 반드시 바꾸세요. 이 화면에는 고객 이름·연락처가 있습니다.
DASHBOARD_ACCESS_CODE=redwind7

# 한 번 들어가면 유지되는 시간(시간). 기본 12
DASHBOARD_SESSION_HOURS=12

# 쿠키 서명용 비밀값. 비워 두면 .dashboard_secret 파일에 자동으로 만들어진다.
# 여러 대에 나눠 띄울 때만 같은 값으로 맞춰 주면 된다.
# 이 값을 바꾸면 열려 있던 창이 전부 로그아웃된다.
DASHBOARD_SECRET=

# 고객 DB 와 비밀값을 둘 폴더. 비우면 저장소 폴더.
# 클라우드에 올릴 때는 디스크가 붙은 경로를 넣어야 배포해도 고객 정보가 남는다.
DASHBOARD_DATA_DIR=

# 외부 API (사용하는 상품에서만 채운다)
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
KAKAO_REST_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── 무료 키 서버 (구글 앱스 스크립트) ────────────────────────────────
#   두 줄을 넣으면, 대시보드에서 발급한 키가 **구글 시트에 함께** 올라갑니다.
#   그러면 이 컴퓨터를 꺼도 고객이 키로 들어옵니다.
#   비우면 지금까지처럼 이 컴퓨터의 장부에만 적습니다.
#   만드는 법: server/README.md
KEYSERVER_URL=
KEYSERVER_PASSWORD=
